# Copy this file to .env and edit the values. .env is never committed.

# Left empty on purpose: with no value Warden starts with a temporary random key
# and prints a warning. Set a permanent one for real use. Generate it with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Optional. Leave empty for the SQLite default at instance/warden.db.
DATABASE_URL=

# 1 enables the debugger and reloader. Keep 0 on the lab server.
FLASK_DEBUG=0

# Where python app.py listens.
WARDEN_HOST=127.0.0.1
WARDEN_PORT=5000

# Set to true only when Warden is served over HTTPS.
SESSION_COOKIE_SECURE=false

# Optional. The directory a scan target must stay inside; empty means the folder holding app.py.
# The default target is sample_repo inside it.
WARDEN_SCAN_BASE=

# Passwords for the two demo accounts that `flask --app app seed` creates.
# Leave a line empty and the seed generates that password and prints it once.
# A value is used exactly as written; a blank line means generate.
WARDEN_ADMIN_PASSWORD=
WARDEN_VIEWER_PASSWORD=
